# ------------------------------------------------------------------
# CrisisDesk AI — environment variables (copy to .env and fill in)
# ------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (Neon PostgreSQL) — get both from the Neon dashboard
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/crisisdesk?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/crisisdesk?sslmode=require

# JWT / Admin auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@crisisdesk.ai
ADMIN_PASSWORD_HASH=

# AI providers (fallback order Gemini -> Groq -> OpenRouter). Keys optional individually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# AI behavior
AI_TIMEOUT_MS=8000
AI_RETRIES=1
MOCK_AI=false
AI_RULE_BASED_FALLBACK=false

# Duplicate detection
DUP_STRATEGY=hybrid
DUP_THRESHOLD=0.72
DUP_TEXT_HARD=0.90
DUP_WINDOW_DAYS=7
DUP_CANDIDATE_LIMIT=200

# External APIs — Geocoding (Nominatim, no key)
GEOCODING_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CrisisDeskAI/1.0 (contact@yourdomain)
LOCATIONIQ_API_KEY=

# External APIs — Weather (Open-Meteo, no key)
WEATHER_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CATEGORIES=flood,infrastructure,utility
WEATHER_HEAVY_RAIN_MM=50

# External APIs — Email alerts (Resend)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAILS=responder@example.com
ALERT_MIN_URGENCY=high

# External behavior
EXTERNAL_API_TIMEOUT_MS=6000
MOCK_EXTERNAL=false

# Security
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
